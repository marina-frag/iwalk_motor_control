<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="iwalk">

  <xacro:include filename="$(find iwalk_description)/urdf/iwalk.urdf.xacro"/>

  <ros2_control name="IwalkVescSystem" type="system">
    <hardware>
      <plugin>iwalk_hardware/VescSystem</plugin>
      <param name="can_interface">vcan0</param>
      <param name="feedback_timeout">0.2</param>
    </hardware>

    <joint name="left_rear_wheel_joint">
      <param name="vesc_id">1</param>
      <param name="pole_pairs">7</param>
      <param name="gear_ratio">1.0</param>
      <param name="direction">1</param>
      <param name="max_erpm">10000</param>

      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_rear_wheel_joint">
      <param name="vesc_id">2</param>
      <param name="pole_pairs">7</param>
      <param name="gear_ratio">1.0</param>
      <param name="direction">1</param>
      <param name="max_erpm">10000</param>

      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
